model User {
  id Int @id @default(autoincrement())
  username String
  email String @unique
  passwordHash String
  refreshSessions RefreshSession[]
}

model Post {
  id Int @id @default(autoincrement())
  title String
  content String
}

model RefreshSession {
  id Int @id @default(autoincrement())
  tokenHash String @unique
  userId Int
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}
